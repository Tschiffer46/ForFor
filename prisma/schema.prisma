generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────

enum UserRole {
  ORG_ADMIN
  CLUB_ADMIN
  TEAM_MEMBER
}

enum OrderStatus {
  OBETALD
  BETALD
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum VisitResult {
  KOPT
  NEJ_TACK
  NEJ_TACK_FRAMTIDEN
  INGEN_HEMMA
  EJ_BESIKT
}

enum DeliveryStatus {
  EJ_HAMTAD
  HAMTAD
  EJ_LEVERERAD
  LEVERERAD
  MISSLYCKAD
}

enum SupplierOrderStatus {
  PENDING
  ORDERED
  DELIVERED
}

// ─── Organization (AZ Profil) ───────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clubs     Club[]
  products  Product[]
  users     User[]
  suppliers Supplier[]

  @@map("organizations")
}

// ─── Product (managed at org level) ─────────────────────

model Product {
  id               String  @id @default(cuid())
  name             String
  description      String?
  price            Int      // Price in SEK (whole number)
  listPrice        Int?     // What AZ Profil charges clubs (SEK)
  imageUrl         String?
  active           Boolean  @default(true)
  archived         Boolean  @default(false)
  size             String?  // e.g. "500g", "1kg"
  weightPerUnit    Float?   // kg per unit
  sacksPerPallet   Int?
  mustBuyPerPallet Boolean  @default(false)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  campaignProducts CampaignProduct[]
  orderItems       OrderItem[]
  images           ProductImage[]
  productSuppliers ProductSupplier[]
  priceCampaigns   PriceCampaign[]
  supplierOrders   SupplierOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

// ─── Club (Uppåkra IF, Torns IF) ────────────────────────

model Club {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  sport        String?
  address      String?
  postalCode   String?
  city         String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  website      String?
  logoUrl      String?
  color1       String? // Club colors for sales page
  color2       String?
  color3       String?
  color4       String?
  active             Boolean @default(true)
  prefix             String? // e.g. "UIF" for customer number prefix
  nextCustomerNumber Int     @default(10001)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  lagGroups  LagGroup[]
  campaigns  Campaign[]
  users      User[]
  keyPersons ClubKeyPerson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clubs")
}

// ─── LagGroup ("Flickor 08", "Pojkar 09") ───────────────

model LagGroup {
  id   String @id @default(cuid())
  name String

  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  teams Team[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lag_groups")
}

// ─── Team ("Team A" — owns districts with streets) ──────

model Team {
  id       String @id @default(cuid())
  name     String
  username String? @unique
  password String? // hashed

  lagGroupId String
  lagGroup   LagGroup @relation(fields: [lagGroupId], references: [id], onDelete: Cascade)

  districts     District[]
  users         User[]
  orders        Order[]
  campaignTeams CampaignTeam[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("teams")
}

// ─── District (geographic group of streets) ─────────────

model District {
  id   String @id @default(cuid())
  name String

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  streets Street[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("districts")
}

// ─── Street ─────────────────────────────────────────────

model Street {
  id   String @id @default(cuid())
  name String
  city String

  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  addresses Address[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("streets")
}

// ─── Address ────────────────────────────────────────────

model Address {
  id         String @id @default(cuid())
  street     String // Full street address like "Storgatan 1"
  postalCode String
  city       String

  streetId String
  streetRef Street @relation(fields: [streetId], references: [id], onDelete: Cascade)

  customers Customer[]
  visits    AddressVisit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("addresses")
}

// ─── Customer ───────────────────────────────────────────

model Customer {
  id             String  @id @default(cuid())
  customerNumber String  @unique
  name           String
  phone          String?
  email          String?
  subscription   Boolean @default(false) // 10% discount

  addressId String
  address   Address @relation(fields: [addressId], references: [id], onDelete: Cascade)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers")
}

// ─── Campaign (replaces Saljrunda) ──────────────────────

model Campaign {
  id             String         @id @default(cuid())
  name           String
  status         CampaignStatus @default(DRAFT)
  salesStart     DateTime
  salesEnd       DateTime
  deliveryStart    DateTime?
  deliveryEnd      DateTime?
  preparationStart DateTime?
  preparationEnd   DateTime?
  transportStart   DateTime?
  transportEnd     DateTime?
  recurring        Boolean        @default(true)

  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  products      CampaignProduct[]
  orders        Order[]
  campaignTeams CampaignTeam[]
  addressVisits AddressVisit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("campaigns")
}

// ─── CampaignProduct (which products in which campaign) ─

model CampaignProduct {
  id String @id @default(cuid())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId])
  @@map("campaign_products")
}

// ─── Order ──────────────────────────────────────────────

model Order {
  id          String      @id @default(cuid())
  status      OrderStatus @default(OBETALD)
  totalAmount Int         // Total in SEK
  swishQrCode String?
  comment     String?     // Salesperson comment
  source      String      @default("SALES_REP") // "SALES_REP" or "WEB"

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  teamId  String
  team    Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  sellerId String?
  seller   User?  @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  items      OrderItem[]
  deliveries Delivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

// ─── OrderItem ──────────────────────────────────────────

model OrderItem {
  id              String  @id @default(cuid())
  quantity        Int
  unitPrice       Int     // Price at time of order
  discountApplied Boolean @default(false)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("order_items")
}

// ─── AddressVisit (tracking door-to-door visits) ────────

model AddressVisit {
  id      String      @id @default(cuid())
  result  VisitResult
  notes   String?

  addressId String
  address   Address @relation(fields: [addressId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("address_visits")
}

// ─── Delivery ───────────────────────────────────────────

model Delivery {
  id      String         @id @default(cuid())
  status  DeliveryStatus @default(EJ_LEVERERAD)
  notes   String?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  deliveredById String?
  deliveredBy   User?  @relation("DeliveriesDelivered", fields: [deliveredById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("deliveries")
}

// ─── Supplier (AZ Profil's suppliers) ─────────────────────

model Supplier {
  id           String  @id @default(cuid())
  name         String
  contactName  String?
  contactEmail String?
  contactPhone String?
  notes        String?
  active       Boolean @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  products       ProductSupplier[]
  supplierOrders SupplierOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("suppliers")
}

// ─── ProductSupplier (which suppliers sell which products) ─

model ProductSupplier {
  id        String  @id @default(cuid())
  sellPrice Int     // Supplier's sell price to AZ Profil (SEK)
  isCurrent Boolean @default(false) // "Nuvarande" supplier

  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@map("product_suppliers")
}

// ─── SupplierOrder (orders from AZ Profil to suppliers) ───

model SupplierOrder {
  id               String              @id @default(cuid())
  quantity         Int
  status           SupplierOrderStatus @default(PENDING)
  orderDate        DateTime?
  expectedDelivery DateTime?
  actualDelivery   DateTime?
  notes            String?

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("supplier_orders")
}

// ─── ClubKeyPerson (Ordförande, Försäljningsansvarig, etc.) ─

model ClubKeyPerson {
  id    String  @id @default(cuid())
  role  String  // 'ordforande', 'forsaljningsansvarig', 'nyckelperson_1', 'nyckelperson_2', 'nyckelperson_3'
  name  String
  email String?
  phone String?

  clubId String
  club   Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, role])
  @@map("club_key_persons")
}

// ─── ProductImage (up to 3 images per product) ───────────

model ProductImage {
  id        String @id @default(cuid())
  imagePath String
  sortOrder Int    @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("product_images")
}

// ─── PriceCampaign (temporary discounts on products) ─────

model PriceCampaign {
  id            String  @id @default(cuid())
  discountType  String  // 'percentage' or 'absolute'
  discountValue Int     // Percentage (e.g. 10) or SEK amount
  startDate     DateTime
  endDate       DateTime
  description   String?
  active        Boolean @default(true)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("price_campaigns")
}

// ─── CampaignTeam (which teams participate in which campaign) ─

model CampaignTeam {
  id String @id @default(cuid())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  teamId String
  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([campaignId, teamId])
  @@map("campaign_teams")
}

// ─── User ───────────────────────────────────────────────

model User {
  id       String   @id @default(cuid())
  name     String
  email    String?  @unique
  phone    String?
  username String   @unique
  password String   // bcrypt hashed
  role     UserRole

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  clubId String?
  club   Club?  @relation(fields: [clubId], references: [id], onDelete: Cascade)

  teamId String?
  team   Team?  @relation(fields: [teamId], references: [id], onDelete: SetNull)

  orders         Order[]
  visits         AddressVisit[]
  deliveries     Delivery[] @relation("DeliveriesDelivered")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
