generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────

enum UserRole {
  ORG_ADMIN
  CLUB_ADMIN
  TEAM_MEMBER
}

enum OrderStatus {
  OBETALD
  BETALD
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum VisitResult {
  KOPT
  NEJ_TACK
  NEJ_TACK_FRAMTIDEN
  INGEN_HEMMA
  EJ_BESIKT
}

enum DeliveryStatus {
  EJ_LEVERERAD
  LEVERERAD
  MISSLYCKAD
}

// ─── Organization (AZ Profil) ───────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clubs    Club[]
  products Product[]
  users    User[]

  @@map("organizations")
}

// ─── Product (managed at org level) ─────────────────────

model Product {
  id          String  @id @default(cuid())
  name        String
  description String?
  price       Int     // Price in SEK (whole number)
  imageUrl    String?
  active      Boolean @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  campaignProducts CampaignProduct[]
  orderItems       OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

// ─── Club (Uppåkra IF, Torns IF) ────────────────────────

model Club {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  sport        String?
  address      String?
  postalCode   String?
  city         String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  website      String?
  active       Boolean @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  lagGroups LagGroup[]
  campaigns Campaign[]
  users     User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clubs")
}

// ─── LagGroup ("Flickor 08", "Pojkar 09") ───────────────

model LagGroup {
  id   String @id @default(cuid())
  name String

  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  teams Team[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lag_groups")
}

// ─── Team ("Team A" — owns districts with streets) ──────

model Team {
  id       String @id @default(cuid())
  name     String
  username String? @unique
  password String? // hashed

  lagGroupId String
  lagGroup   LagGroup @relation(fields: [lagGroupId], references: [id], onDelete: Cascade)

  districts District[]
  users     User[]
  orders    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("teams")
}

// ─── District (geographic group of streets) ─────────────

model District {
  id   String @id @default(cuid())
  name String

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  streets Street[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("districts")
}

// ─── Street ─────────────────────────────────────────────

model Street {
  id   String @id @default(cuid())
  name String
  city String

  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  addresses Address[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("streets")
}

// ─── Address ────────────────────────────────────────────

model Address {
  id         String @id @default(cuid())
  street     String // Full street address like "Storgatan 1"
  postalCode String
  city       String

  streetId String
  streetRef Street @relation(fields: [streetId], references: [id], onDelete: Cascade)

  customers Customer[]
  visits    AddressVisit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("addresses")
}

// ─── Customer ───────────────────────────────────────────

model Customer {
  id           String  @id @default(cuid())
  name         String
  phone        String?
  email        String?
  subscription Boolean @default(false) // 10% discount

  addressId String
  address   Address @relation(fields: [addressId], references: [id], onDelete: Cascade)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers")
}

// ─── Campaign (replaces Saljrunda) ──────────────────────

model Campaign {
  id             String         @id @default(cuid())
  name           String
  status         CampaignStatus @default(DRAFT)
  salesStart     DateTime
  salesEnd       DateTime
  deliveryStart  DateTime?
  deliveryEnd    DateTime?
  recurring      Boolean        @default(true)

  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  products CampaignProduct[]
  orders   Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("campaigns")
}

// ─── CampaignProduct (which products in which campaign) ─

model CampaignProduct {
  id String @id @default(cuid())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId])
  @@map("campaign_products")
}

// ─── Order ──────────────────────────────────────────────

model Order {
  id          String      @id @default(cuid())
  status      OrderStatus @default(OBETALD)
  totalAmount Int         // Total in SEK
  swishQrCode String?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  teamId  String
  team    Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  sellerId String?
  seller   User?  @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  items      OrderItem[]
  deliveries Delivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

// ─── OrderItem ──────────────────────────────────────────

model OrderItem {
  id              String  @id @default(cuid())
  quantity        Int
  unitPrice       Int     // Price at time of order
  discountApplied Boolean @default(false)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("order_items")
}

// ─── AddressVisit (tracking door-to-door visits) ────────

model AddressVisit {
  id      String      @id @default(cuid())
  result  VisitResult
  notes   String?

  addressId String
  address   Address @relation(fields: [addressId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  campaignId String?

  createdAt DateTime @default(now())

  @@map("address_visits")
}

// ─── Delivery ───────────────────────────────────────────

model Delivery {
  id      String         @id @default(cuid())
  status  DeliveryStatus @default(EJ_LEVERERAD)
  notes   String?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  deliveredById String?
  deliveredBy   User?  @relation("DeliveriesDelivered", fields: [deliveredById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("deliveries")
}

// ─── User ───────────────────────────────────────────────

model User {
  id       String   @id @default(cuid())
  name     String
  email    String?  @unique
  phone    String?
  username String   @unique
  password String   // bcrypt hashed
  role     UserRole

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  clubId String?
  club   Club?  @relation(fields: [clubId], references: [id], onDelete: Cascade)

  teamId String?
  team   Team?  @relation(fields: [teamId], references: [id], onDelete: SetNull)

  orders         Order[]
  visits         AddressVisit[]
  deliveries     Delivery[] @relation("DeliveriesDelivered")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
